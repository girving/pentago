#!/bin/bash
# One-time setup so `bin/bazel` works normally inside a Claude remote
# container.  The container's network proxy blocks releases.bazel.build,
# bcr.bazel.build, and GitHub codeload archives (except this repo), but
# allows GitHub release assets, raw.githubusercontent.com, npm, Ubuntu apt,
# and git clones of arbitrary public repos.  We route bazel around the
# blocked pieces:
#   - bazelisk fetches bazel itself from GitHub release assets (.bazeliskrc)
#   - the module registry is the BCR's GitHub mirror via raw.githubusercontent
#   - the deps whose sources are codeload tarballs (snappy, rules_perl,
#     tinyformat, random123) are cloned at their pinned revisions and wired
#     in with --override_module / --override_repository (.bazelrc.local)
# Revisions below must stay in sync with MODULE.bazel and third_party/deps.bzl.
set -e
cd "$(dirname "$0")/.."

bcr=https://raw.githubusercontent.com/bazelbuild/bazel-central-registry/main
ov=.cache/overrides
mkdir -p $ov

# System packages: MPI for //pentago/mpi, clang+lld for //web/client:wasm
sudo apt-get install -y -qq libopenmpi-dev clang lld

# The web client unit test looks for node in /usr/local/bin
if [ ! -e /usr/local/bin/node ] && [ -e /opt/node22/bin/node ]; then
  sudo ln -s /opt/node22/bin/node /usr/local/bin/node
fi

# bazelisk, pointed at GitHub since releases.bazel.build is blocked
if ! command -v bazelisk &> /dev/null; then
  sudo curl -sSL -o /usr/local/bin/bazelisk \
    https://github.com/bazelbuild/bazelisk/releases/download/v1.26.0/bazelisk-linux-amd64
  sudo chmod +x /usr/local/bin/bazelisk
fi
echo "BAZELISK_BASE_URL=https://github.com/bazelbuild/bazel/releases/download" > .bazeliskrc

# Clone a repo at a pinned revision, dropping any existing partial clone
clone () {
  local dir="$1" url="$2" rev="$3"
  if [ ! -e "$dir/.git" ]; then
    rm -rf "$dir"
    git clone --quiet "$url" "$dir"
    git -C "$dir" checkout --quiet "$rev"
  fi
}

# snappy, with the BCR revision's patches applied by hand since
# --override_module bypasses registry patching
if [ ! -e $ov/snappy/.git ]; then
  clone $ov/snappy https://github.com/google/snappy 1.2.2
  for p in bazel_9 fix_header_collision; do
    curl -sS $bcr/modules/snappy/1.2.2.bcr.3/patches/$p.patch |
      patch --quiet -p1 -d $ov/snappy
  done
fi

# rules_perl (transitive dep of curl and boringssl), ditto
if [ ! -e $ov/rules_perl/.git ]; then
  clone $ov/rules_perl https://github.com/bazel-contrib/rules_perl 0.2.4
  curl -sS $bcr/modules/rules_perl/0.2.4/patches/module_dot_bazel_version.patch |
    patch --quiet -p0 -d $ov/rules_perl
fi

# tinyformat and random123: plain repos from third_party/deps.bzl, which
# normally get their BUILD file via build_file; overrides need it in-tree
clone $ov/tinyformat https://github.com/c42f/tinyformat 3a33bbf65442432277eee079e83d3e8fac51730c
cp third_party/tinyformat.BUILD $ov/tinyformat/BUILD.bazel
touch $ov/tinyformat/REPO.bazel
clone $ov/random123 https://github.com/DEShawResearch/random123 9545ff6413f258be2f04c1d319d99aaef7521150
cp third_party/random123.BUILD $ov/random123/BUILD.bazel
touch $ov/random123/REPO.bazel

cat > .bazelrc.local << 'EOF'
# Generated by bin/sandbox-setup for Claude remote containers (see comments
# there); loaded via the try-import in .bazelrc
common --registry=https://raw.githubusercontent.com/bazelbuild/bazel-central-registry/main
common --override_module=snappy=%workspace%/.cache/overrides/snappy
common --override_module=rules_perl=%workspace%/.cache/overrides/rules_perl
common --override_repository=+deps+tinyformat=%workspace%/.cache/overrides/tinyformat
common --override_repository=+deps+random123=%workspace%/.cache/overrides/random123
# The container runs as root, which OpenMPI refuses without these
test --test_env=OMPI_ALLOW_RUN_AS_ROOT=1 --test_env=OMPI_ALLOW_RUN_AS_ROOT_CONFIRM=1
EOF

echo "Done: bin/bazel {build,test} -c opt ... should now work"
