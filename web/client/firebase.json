{
  "hosting": {
    "site": "perfect-pentago",
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.wasm",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/wasm"
          }
        ]
      },
      {
        "source": "{/,**/*.@(html|js|wasm)}",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "same-origin"
          },
          {
            "key": "Cross-Origin-Embedder-Policy",
            "value": "require-corp"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/backend",
        "function": {
          "functionId": "pentago",
          "region": "us-central1"
        }
      },
      {
        "source": "/backend/**",
        "function": {
          "functionId": "pentago",
          "region": "us-central1"
        }
      }
    ]
  }
}
