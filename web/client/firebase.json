{
  "hosting": {
    "site": "perfect-pentago",
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.wasm",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/wasm"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/backend",
        "function": {
          "functionId": "pentago",
          "region": "us-central1"
        }
      },
      {
        "source": "/backend/**",
        "function": {
          "functionId": "pentago",
          "region": "us-central1"
        }
      }
    ]
  }
}
