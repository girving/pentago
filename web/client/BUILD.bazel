# Pentago web client.  Everything the site serves is either generated by
# bazel (index.html, svgs, wasm) or served verbatim from src/ and public/.
# See ./stage, ./serve, and ./deploy for assembling and publishing the tree.

load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:private"])

genrule(
    name = "index",
    outs = ["public/index.html"],
    cmd = "$(location //web/client/cc:site) > $@",
    tools = ["//web/client/cc:site"],
)

genrule(
    name = "counts",
    outs = ["public/counts.svg"],
    cmd = "$(location //web/client/cc:svgs) counts > $@",
    tools = ["//web/client/cc:svgs"],
)

genrule(
    name = "favicon",
    outs = ["public/favicon.svg"],
    cmd = "$(location //web/client/cc:svgs) favicon > $@",
    tools = ["//web/client/cc:svgs"],
)

# Freestanding wasm midsolver, compiled with homebrew clang (not hermetic)
genrule(
    name = "wasm",
    srcs = [
        "//pentago/base:srcs",
        "//pentago/base:tables",
        "//pentago/data:srcs",
        "//pentago/high:srcs",
        "//pentago/mid:srcs",
        "//pentago/utility:srcs",
        "//third_party:freestanding",
    ],
    outs = [
        "public/mid.wasm",
        "build/tests.wasm",
    ],
    cmd = "./$(location build-wasm) $(location public/mid.wasm) $(location build/tests.wasm) $(BINDIR)",
    tools = ["build-wasm"],
)

# esbuild binary for the host platform (pinned in third_party/deps.bzl)
config_setting(
    name = "darwin_arm64",
    constraint_values = ["@platforms//os:macos", "@platforms//cpu:arm64"],
)

config_setting(
    name = "darwin_x64",
    constraint_values = ["@platforms//os:macos", "@platforms//cpu:x86_64"],
)

alias(
    name = "esbuild",
    actual = select({
        ":darwin_arm64": "@esbuild_darwin_arm64//:bin/esbuild",
        ":darwin_x64": "@esbuild_darwin_x64//:bin/esbuild",
        "//conditions:default": "@esbuild_linux_x64//:bin/esbuild",
    }),
)

# Bundled and minified runtime: app.js pulls in its imports, mid_worker.js
# pulls in the wasm interface (fs is the unused node branch of mid_sync.js)
genrule(
    name = "app",
    srcs = [
        "src/app.js",
        "src/board.js",
        "src/cache.js",
        "src/mid_async.js",
        "src/pending.js",
    ],
    outs = ["public/app.js"],
    cmd = "$(location :esbuild) --bundle --minify --format=esm --log-level=warning " +
          "--outfile=$@ $(location src/app.js)",
    tools = [":esbuild"],
)

genrule(
    name = "worker",
    srcs = [
        "src/mid_sync.js",
        "src/mid_worker.js",
    ],
    outs = ["public/mid_worker.js"],
    cmd = "$(location :esbuild) --bundle --minify --format=esm --external:fs --log-level=warning " +
          "--outfile=$@ $(location src/mid_worker.js)",
    tools = [":esbuild"],
)

genrule(
    name = "css",
    srcs = ["src/main.css"],
    outs = ["public/main.css"],
    cmd = "$(location :esbuild) --minify --log-level=warning --outfile=$@ $(location src/main.css)",
    tools = [":esbuild"],
)

# Everything the site serves
filegroup(
    name = "site",
    srcs = [
        "public/details.html",
        ":app",
        ":counts",
        ":css",
        ":favicon",
        ":index",
        ":wasm",
        ":worker",
    ],
    visibility = ["//visibility:public"],
)

sh_test(
    name = "unit",
    srcs = ["unit_test.sh"],
    size = "small",
    # Midsolves are dealt round-robin to shards (see unit.js); wall time is
    # roughly one 18-stone solve
    shard_count = 10,
    data = [
        ":wasm",
        "src/board.js",
        "src/games.js",
        "src/mid_sync.js",
        "src/pending.js",
        "src/unit.js",
    ],
)
