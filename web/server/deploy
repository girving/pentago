#!/bin/bash

cd "$(dirname "$0")"
# --no-gen2 keeps the existing 1st gen function (new gcloud defaults to gen2).
# --max-instances bounds worst-case spend (compute + coldline retrieval) under a request flood.
gcloud functions deploy pentago --no-gen2 --runtime=nodejs22 --trigger-http --region=us-central1 \
    --allow-unauthenticated --security-level=secure-always --max-instances=4 \
    --service-account=pentago-read@naml-148801.iam.gserviceaccount.com
